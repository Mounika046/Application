# Agntcy directory discovery
AGNTCY_DIRECTORY_DISCOVERY_ENABLED=false
AGNTCY_DIRECTORY_SERVER_ADDR=127.0.0.1:8888
AGNTCY_DIRECTORY_DISCOVERY_TIMEOUT_S=5
AGNTCY_DIRECTORY_NAME_PREFIX=application
AGNTCY_DIRCTL_PATH=

# Agntcy identity verification
AGNTCY_IDENTITY_REST_BASE_URL=https://api.agent-identity.outshift.com
AGNTCY_IDENTITY_ORG_API_KEY=replace-with-your-organization-api-key
AGNTCY_IDENTITY_VERIFY_TIMEOUT_S=10
