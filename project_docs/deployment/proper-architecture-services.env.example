# OCR server
OCR_MCP_HOST=0.0.0.0
OCR_MCP_PORT=8011
# POPPLER_PATH=<set only if required by the runtime image>

# Document ingest agent
DOC_INGEST_AGENT_HOST=0.0.0.0
DOC_INGEST_AGENT_PORT=8031
DOC_INGEST_AGENT_PUBLIC_URL=https://document-ingest-agent.example.internal
OCR_MCP_SERVER_URL=https://ocr-server.example.internal/mcp

# Document query agent
DOCUMENT_QUERY_AGENT_HOST=0.0.0.0
DOCUMENT_QUERY_AGENT_PORT=8032
DOCUMENT_QUERY_AGENT_PUBLIC_URL=https://kb-query-agent.example.internal

# Web search agent
WEB_SEARCH_AGENT_HOST=0.0.0.0
WEB_SEARCH_AGENT_PORT=8033
WEB_SEARCH_AGENT_PUBLIC_URL=https://web-search-agent.example.internal
SERPAPI_API_KEY=<serpapi-key>

# Comparison agent
COMPARISON_AGENT_HOST=0.0.0.0
COMPARISON_AGENT_PORT=8034
COMPARISON_AGENT_PUBLIC_URL=https://comparison-agent.example.internal

# Shared OCI Enterprise AI values for agents
OCI_EAI_ENABLED=true
OCI_EAI_BASE_URL=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com/openai/v1
OCI_EAI_PROJECT_OCID=<project-ocid>
OCI_EAI_COMPARTMENT_ID=<compartment-ocid>
OCI_EAI_VECTOR_STORE_ID=<vector-store-id>
OCI_EAI_AUTH_MODE=resource_principal
OCI_EAI_MODEL=openai.gpt-oss-120b
OCI_EAI_CONVERSATIONS_ENABLED=true

# Recommended while validating the split deployment
AGNTCY_DIRECTORY_DISCOVERY_ENABLED=false
AGNTCY_IDENTITY_VERIFY_ENABLED=false

# Optional comparison controls
# OCI_EAI_COMPARE_CODE_INTERPRETER_ENABLED=true
# OCI_EAI_COMPARE_CODE_INTERPRETER_MEMORY=1g

# Guardrails are hardcoded in the application now, so no extra env vars are required for them.
