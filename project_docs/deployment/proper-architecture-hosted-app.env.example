# Hosted app runtime
HOSTED_APP_HOST=0.0.0.0
HOSTED_APP_PORT=8080

# Split-service wiring
DOC_INGEST_AGENT_URL=https://document-ingest-agent.example.internal
DOCUMENT_QUERY_AGENT_URL=https://kb-query-agent.example.internal
WEB_SEARCH_AGENT_URL=https://web-search-agent.example.internal
COMPARISON_AGENT_URL=https://comparison-agent.example.internal

# Recommended while validating the split deployment
AGNTCY_DIRECTORY_DISCOVERY_ENABLED=false
AGNTCY_IDENTITY_VERIFY_ENABLED=false

# Shared file transport
SHARED_FILE_REF_STRATEGY=inline
SHARED_FILE_INLINE_MAX_BYTES=5242880

# OCI Enterprise AI
OCI_EAI_ENABLED=true
OCI_EAI_BASE_URL=https://inference.generativeai.ap-hyderabad-1.oci.oraclecloud.com/openai/v1
OCI_EAI_PROJECT_OCID=<project-ocid>
OCI_EAI_COMPARTMENT_ID=<compartment-ocid>
OCI_EAI_VECTOR_STORE_ID=<vector-store-id>
OCI_EAI_AUTH_MODE=resource_principal
OCI_EAI_MODEL=openai.gpt-oss-120b
OCI_EAI_CONVERSATIONS_ENABLED=true

# If resource principal cannot be granted the required OCI permissions, switch to:
# OCI_EAI_AUTH_MODE=user
# OCI_EAI_CONFIG_PROFILE=DEFAULT
# OCI_EAI_USER_TENANCY_OCID=<tenancy-ocid>
# OCI_EAI_USER_OCID=<user-ocid>
# OCI_EAI_USER_FINGERPRINT=<api-key-fingerprint>
# OCI_EAI_USER_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Optional:
# OCI_EAI_USER_PRIVATE_KEY_PASSPHRASE=<private-key-passphrase>

# Guardrails are hardcoded in the application now, so no extra env vars are required for them.

# Web route dependency
SERPAPI_API_KEY=<serpapi-key>

# Optional AGNTCY values if you later re-enable discovery/trust
# AGNTCY_DIRECTORY_SERVER_ADDR=<directory-host:port>
# AGNTCY_DIRCTL_PATH=/app/agntcy/bin/dirctl-linux
# AGNTCY_IDENTITY_REST_BASE_URL=https://api.agent-identity.outshift.com
# AGNTCY_IDENTITY_ORG_API_KEY=<org-api-key>
